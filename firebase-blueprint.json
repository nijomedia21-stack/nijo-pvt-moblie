{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile metadata and preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The unique Firebase Auth user ID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp via serverTimestamp" }
      },
      "required": ["userId", "email", "displayName", "createdAt", "updatedAt"]
    },
    "WorkspaceItem": {
      "title": "WorkspaceItem",
      "description": "Cross-device synchronized notes, tasks, and media items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique workspace item ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "type": { "type": "string", "enum": ["NOTE", "TASK", "MEDIA"], "description": "Item category" },
        "title": { "type": "string", "description": "Title of the item" },
        "content": { "type": "string", "description": "Main body or notes content" },
        "isCompleted": { "type": "boolean", "description": "Task completion state" },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"], "description": "Priority level" },
        "tags": { "type": "array", "description": "Categorical tags, bounded to at most 10 items" },
        "imageUrl": { "type": "string", "description": "Optional image data or preview URI" },
        "aiSummary": { "type": "string", "description": "Optional AI analysis or generated summary" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server last update timestamp" }
      },
      "required": ["id", "userId", "type", "title", "content", "isCompleted", "priority", "tags", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Multi-turn Gemini AI conversation history message",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique chat message ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "role": { "type": "string", "enum": ["user", "model"], "description": "Message author role" },
        "text": { "type": "string", "description": "Message content" },
        "thinkingText": { "type": "string", "description": "Optional high thinking reasoning trace" },
        "modelUsed": { "type": "string", "description": "Model identifier such as gemini-4-argon or gemini-3.8-flash" },
        "hasImage": { "type": "boolean", "description": "Whether an image was attached" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Server timestamp of message" }
      },
      "required": ["id", "userId", "role", "text", "modelUsed", "hasImage", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document storing basic account identity"
    },
    "/users/{userId}/items/{itemId}": {
      "schema": "WorkspaceItem",
      "description": "Collection of notes, tasks, and media items belonging to the user"
    },
    "/users/{userId}/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Multi-turn AI assistant chat message history"
    }
  }
}
